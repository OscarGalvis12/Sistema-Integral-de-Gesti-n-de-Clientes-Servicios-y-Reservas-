from datetime import datetime
from typing import List, Optional, Dict, Any

# ----------------------- CONFIGURACIÓN DE LOGGING -----------------------
logging.basicConfig(
    filename='software_fj.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    datefmt='%Y-%m-%d %H:%M:%S'
